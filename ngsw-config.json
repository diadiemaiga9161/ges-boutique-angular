{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/**/*__*",
    "!/**/*__*/**",
    "!/vitrine",
    "!/vitrine/**",
    "!/mobile",
    "!/mobile/**"
  ],
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-produits",
      "urls": ["/api/produits", "/api/produits/**"],
      "cacheConfig": {
        "maxSize": 100,
        "maxAge": "1h",
        "timeout": "5s",
        "strategy": "freshness"
      }
    },
    {
      "name": "api-ventes",
      "urls": ["/api/ventes", "/api/rapports/**", "/api/ia/**"],
      "cacheConfig": {
        "maxSize": 200,
        "maxAge": "30m",
        "timeout": "5s",
        "strategy": "freshness"
      }
    },
    {
      "name": "api-other",
      "urls": ["/api/boutiques/**", "/api/clients/**", "/api/categories/**"],
      "cacheConfig": {
        "maxSize": 50,
        "maxAge": "2h",
        "timeout": "5s",
        "strategy": "freshness"
      }
    }
  ]
}
